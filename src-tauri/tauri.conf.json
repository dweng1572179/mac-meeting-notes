{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meeting Notes",
  "version": "0.2.5",
  "identifier": "com.dweng.meetingnotes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Meeting Notes",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "copyright": "Copyright © 2026 Darryl Weng",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "14.2",
      "infoPlist": "Info.plist"
    }
  }
}
